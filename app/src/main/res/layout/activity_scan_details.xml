<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:background="@color/topBottomColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/topBottomColor"
        android:elevation="0dp">

        <ImageView
            android:id="@+id/icBackImg"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/baseline_arrow_back_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textColor" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/scan_details"
            android:textColor="@color/textColor"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/icCopy"
            app:layout_constraintStart_toEndOf="@+id/icBackImg"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/icCopy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_copy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/saveIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textColor" />

        <ImageView
            android:id="@+id/saveIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/outline_create_new_folder_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textColor" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Editable Scrollable Text -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true">

        <EditText
            android:id="@+id/editTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="all"
            android:background="@null"
            android:cursorVisible="true"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="start|top"
            android:hint="@string/write_or_edit_scanned_text"
            android:imeOptions="flagNoEnterAction"
            android:importantForAutofill="yes"
            android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
            android:overScrollMode="always"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:singleLine="false"
            android:textColor="@color/textColor"
            android:textColorLink="?attr/colorPrimary"
            android:textIsSelectable="true"
            android:textSize="13sp" />


    </androidx.core.widget.NestedScrollView>

</LinearLayout>
